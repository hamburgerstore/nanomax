<Window x:Class="nanomaxtest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:nanomaxtest"
        Title="NanoMax 300 제어판" Height="900" Width="1100" Icon="app_icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <TabControl Margin="10">
            <TabItem Header="메인 제어">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Orientation="Horizontal" Margin="0,0,0,20" Grid.Row="0" VerticalAlignment="Center">
                        <Button x:Name="btnSearch" Content="기기 검색" Width="80" Height="25" Margin="0,5,10,5" Click="btnSearch_Click"/>
                        <ComboBox x:Name="cmbSerialNo" Width="150" Height="25" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <Button x:Name="btnConnect" Content="연결하기" Width="80" Height="25" Margin="0,5,10,5" Click="btnConnect_Click"/>
                        <Button x:Name="btnDisconnect" Content="연결 해제" Width="80" Height="25" Margin="0,5,10,5" IsEnabled="False" Click="btnDisconnect_Click"/>
                        <TextBlock x:Name="txtGlobalStatus" Text="대기 중" VerticalAlignment="Center" Margin="10,5,20,5" FontWeight="Bold"/>
                        <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="5,5"/>
                        <Button x:Name="btnMainStartMacro" Content="▶ 매크로 실행" Width="100" Height="25" Background="#FFD4EDD4" FontWeight="Bold" Margin="5,5,10,5" IsEnabled="False" Click="btnStartMacro_Click"/>
                        <Button x:Name="btnMainStopMacro" Content="■ 매크로 정지" Width="100" Height="25" Background="#FFFFCCCC" FontWeight="Bold" Margin="0,5,10,5" IsEnabled="False" Click="btnStopMacro_Click"/>
                    </WrapPanel>

                    <Grid Grid.Row="1" Margin="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <local:AxisControl x:Name="ctrlX" Grid.Column="0" Margin="5" Title="X 축 [좌/우] (CH 3 연결됨)"/>
                        <local:AxisControl x:Name="ctrlY" Grid.Column="1" Margin="5" Title="Y 축 [전/후] (CH 2 연결됨)"/>
                        <local:AxisControl x:Name="ctrlZ" Grid.Column="2" Margin="5" Title="Z 축 [상/하] (CH 1 연결됨)"/>
                    </Grid>
                    <GroupBox Grid.Row="2" Header="관심 좌표 (Waypoints)" Margin="0,15,0,0" Padding="5">
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border BorderBrush="LightGray" BorderThickness="0,0,1,0" Margin="5" Padding="10,5">
                                <StackPanel>
                                    <TextBlock Text="Slot 1" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtWp0" Text="[비어있음]" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="현재 위치 저장" Width="90" Margin="0,0,5,0" Tag="0" Click="btnSaveWp_Click"/>
                                        <Button Content="이동" Width="40" Tag="0" Click="btnGoWp_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,1,0" Margin="5" Padding="10,5">
                                <StackPanel>
                                    <TextBlock Text="Slot 2" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtWp1" Text="[비어있음]" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="현재 위치 저장" Width="90" Margin="0,0,5,0" Tag="1" Click="btnSaveWp_Click"/>
                                        <Button Content="이동" Width="40" Tag="1" Click="btnGoWp_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,1,0" Margin="5" Padding="10,5">
                                <StackPanel>
                                    <TextBlock Text="Slot 3" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtWp2" Text="[비어있음]" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="현재 위치 저장" Width="90" Margin="0,0,5,0" Tag="2" Click="btnSaveWp_Click"/>
                                        <Button Content="이동" Width="40" Tag="2" Click="btnGoWp_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="LightGray" BorderThickness="0,0,1,0" Margin="5" Padding="10,5">
                                <StackPanel>
                                    <TextBlock Text="Slot 4" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtWp3" Text="[비어있음]" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="현재 위치 저장" Width="90" Margin="0,0,5,0" Tag="3" Click="btnSaveWp_Click"/>
                                        <Button Content="이동" Width="40" Tag="3" Click="btnGoWp_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border BorderBrush="Transparent" BorderThickness="0" Margin="5" Padding="10,5">
                                <StackPanel>
                                    <TextBlock Text="Slot 5" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="txtWp4" Text="[비어있음]" Margin="0,5,0,10" HorizontalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="현재 위치 저장" Width="90" Margin="0,0,5,0" Tag="4" Click="btnSaveWp_Click"/>
                                        <Button Content="이동" Width="40" Tag="4" Click="btnGoWp_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="매크로">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15" VerticalAlignment="Center">
                        <Button Content="기본 틀(CSV) 다운로드" Width="150" Height="30" Margin="0,5,10,5" Click="btnDownloadCsv_Click"/>
                        <Button Content="CSV 불러오기" Width="100" Height="30" Margin="0,5,10,5" Click="btnLoadCsv_Click"/>
                        <Button Content="목록 초기화" Width="90" Height="30" Margin="0,5,15,5" Click="btnClearMacro_Click"/>
                        <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                            <TextBlock Text="반복 횟수:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtMacroLoops" Width="40" Text="1" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                        </StackPanel>
                        <Button x:Name="btnStartMacro" Content="매크로 시작" Width="100" Height="30" Margin="0,5,10,5" Background="#FFD4EDD4" IsEnabled="False" Click="btnStartMacro_Click"/>
                        <Button x:Name="btnStopMacro" Content="매크로 정지" Width="100" Height="30" Margin="0,5,15,5" Background="#FFFFCCCC" IsEnabled="False" Click="btnStopMacro_Click"/>
                        <CheckBox x:Name="chkMacroApplySlope" Content="Z축 기울기 자동 보정" VerticalAlignment="Center" Margin="0,5,15,5" FontWeight="Bold" Foreground="Blue" ToolTip="어레이 탭의 기준점을 바탕으로 XY 이동 시 Z축 높이를 실시간 보정합니다."/>
                        <CheckBox x:Name="chkMacroWebhook" Content="웹훅 알림" VerticalAlignment="Center" Margin="0,5,15,5" IsChecked="False" ToolTip="매크로 완료 시 설정 탭에 등록된 URL로 웹훅 알림을 전송합니다."/>
                        <TextBlock x:Name="txtMacroStatus" Text="대기 중" VerticalAlignment="Center" Margin="5,5,0,5" FontWeight="Bold"/>
                    </WrapPanel>
                    <GroupBox Grid.Row="1" Header="이동/대기 명령 추가" Margin="0,0,0,15" Padding="10,5">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="명령/축:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="cmbMacroAxis" Width="60" SelectedIndex="0" SelectionChanged="cmbMacroAxis_SelectionChanged">
                                    <ComboBoxItem Content="X"/>
                                    <ComboBoxItem Content="Y"/>
                                    <ComboBoxItem Content="Z"/>
                                    <ComboBoxItem Content="Wait"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="이동 모드:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="cmbMacroMode" Width="60" SelectedIndex="0">
                                    <ComboBoxItem Content="Rel"/>
                                    <ComboBoxItem Content="Abs"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock x:Name="lblMacroTarget" Text="목표값(거리/좌표):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inMacroTarget" Width="70" Text="1" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                                <TextBlock x:Name="unitMacroTarget" Text="mm" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock x:Name="lblMacroVel" Text="이동 속도:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inMacroVel" Width="60" Text="0.5" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                                <TextBlock x:Name="unitMacroVel" Text="mm/s" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <CheckBox x:Name="chkMacroSync" Content="다음 줄과 동시 실행" VerticalAlignment="Center" Margin="0,5,15,5"/>
                            <Button Content="추가" Width="60" Height="25" Margin="0,5,0,5" VerticalAlignment="Center" Click="btnAddMacro_Click"/>
                        </WrapPanel>
                    </GroupBox>
                    <Expander Grid.Row="2" Header="나선/원형 패턴 그리기 (현재 위치 기준)" Margin="0,0,0,15" Padding="5" Background="White" BorderBrush="LightGray" BorderThickness="1" IsExpanded="False">
                        <WrapPanel Orientation="Horizontal" Margin="5,10,5,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="직경 (Diameter):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inCircleDiameter" Width="60" Text="0.005" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" TextChanged="HelixInput_TextChanged"/>
                                <TextBlock x:Name="unitCircleDiameter" Text="mm" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="회전 횟수 (Loops):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inCircleLoops" Width="40" Text="10" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" TextChanged="HelixInput_TextChanged"/>
                                <TextBlock Text="바퀴" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="1회전당 Z축 이동:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inCircleZDist" Width="60" Text="-0.05" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" TextChanged="HelixInput_TextChanged"/>
                                <TextBlock x:Name="unitCircleZDist" Text="mm" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="Z축 이동 속도:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inCircleZVel" Width="80" Text="0.001" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" TextChanged="HelixInput_TextChanged"/>
                                <TextBlock x:Name="unitCircleZVel" Text="mm/s" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="다각형 분할 수 (정밀도):" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inCircleSteps" Width="40" Text="36" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" TextChanged="HelixInput_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="원 회전 속도 (XY) 자동계산:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inCircleVel" Width="90" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput" Background="#FFF0F8FF" ToolTip="Z속도와 파라미터로부터 자동계산됩니다.&#xD;&#xA;직접 수정도 가능합니다."/>
                                <TextBlock x:Name="unitCircleVel" Text="mm/s" VerticalAlignment="Center" Margin="2,0,5,0" Foreground="Gray"/>
                                <TextBlock Text="(직접 수정 가능)" VerticalAlignment="Center" Foreground="Gray" FontSize="11" Margin="0,0,5,0"/>
                            </StackPanel>
                            <Button x:Name="btnDrawCircle" Content="나선(Helix) 그리기 시작" Width="140" Height="25" Margin="0,5,0,5" Background="#FFD4EDD4" VerticalAlignment="Center" Click="btnDrawCircle_Click"/>
                        </WrapPanel>
                    </Expander>
                    <Expander Grid.Row="3" Header="지정 각도로 직선 이동 (간단 버전)" Margin="0,0,0,15" Padding="5" Background="White" BorderBrush="LightGray" BorderThickness="1" IsExpanded="False">
                        <WrapPanel Orientation="Horizontal" Margin="5,10,5,5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="이동 각도:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inAngle" Width="50" Text="45" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                                <TextBlock Text="도(°)" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="총 이동 거리:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inAngleDist" Width="60" Text="1" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                                <TextBlock Text="mm" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,15,5">
                                <TextBlock Text="이동 속도:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="inAngleVel" Width="60" Text="0.1" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                                <TextBlock Text="mm/s" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                            </StackPanel>
                            <Button x:Name="btnMoveAngle" Content="각도 이동 시작" Width="100" Height="25" Margin="0,5,0,5" Background="#FFE6F2FF" VerticalAlignment="Center" Click="btnMoveAngle_Click"/>
                        </WrapPanel>
                    </Expander>
                    <DataGrid x:Name="dgMacro" Grid.Row="4" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" Background="White" RowHeight="30" FontSize="14" AlternatingRowBackground="#FFF0F0F0" CellEditEnding="dgMacro_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="순서" Binding="{Binding Index}" IsReadOnly="True" Width="50"/>
                            <DataGridTextColumn Header="축" Binding="{Binding AxisName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="모드" Binding="{Binding Mode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                            <DataGridTextColumn Header="좌표/거리/시간" Binding="{Binding Target, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.########}}" Width="120"/>
                            <DataGridTextColumn Header="속도" Binding="{Binding Velocity, Mode=TwoWay, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.########}}" Width="90"/>
                            <DataGridCheckBoxColumn Header="동시 실행" Binding="{Binding IsSync, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="예상 시간" Binding="{Binding EstimatedTime, StringFormat={}{0:F1}s}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="남은 시간" Binding="{Binding RemainingTime, StringFormat={}{0:F1}s}" IsReadOnly="True" Width="80"/>
                            <DataGridTextColumn Header="벡터 해석 (동기화)" Binding="{Binding SyncSummary}" IsReadOnly="True" Width="280"/>
                            <DataGridTemplateColumn Header="삭제" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="삭제" Click="btnInlineDeleteMacro_Click" Margin="5,2" Background="#FFFFCCCC"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="어레이">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <GroupBox Header="1. 기울기 측정용 기준점 (최소 2개 ~ 최대 10개)" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="이동 축 선택:" VerticalAlignment="Center" Width="90"/>
                                    <ComboBox x:Name="cmbArrayAxis" Width="80" SelectedIndex="0">
                                        <ComboBoxItem Content="X축"/>
                                        <ComboBoxItem Content="Y축"/>
                                    </ComboBox>
                                    <TextBlock Text="배열 진행 방향:" VerticalAlignment="Center" Width="90" Margin="20,0,0,0"/>
                                    <ComboBox x:Name="cmbArrayGapDir" Width="60" SelectedIndex="0">
                                        <ComboBoxItem Content="+"/>
                                        <ComboBoxItem Content="-"/>
                                    </ComboBox>
                                </StackPanel>
                                <DataGrid x:Name="dgArrayPoints" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False" Background="White" RowHeight="30" FontSize="14" AlternatingRowBackground="#FFF0F0F0" Height="150" Margin="0,0,0,10">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="선택 축 좌표" Binding="{Binding AxisPos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.########}}" Width="120"/>
                                        <DataGridTextColumn Header="Z축 좌표" Binding="{Binding ZPos, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0.########}}" Width="120"/>
                                        <DataGridTemplateColumn Header="현재위치 불러오기" Width="140">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="현재 위치" Margin="5,2" Click="btnSetArrayPoint_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="삭제" Width="80">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="삭제" Margin="5,2" Background="#FFFFCCCC" Click="btnDeleteArrayPoint_Click"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Button Content="점 추가하기" Width="100" Height="25" HorizontalAlignment="Left" Click="btnAddArrayPoint_Click"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="2. 프린팅 파라미터 (현재 위치부터 상대 이동)" Margin="0,0,0,15" Padding="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="프린트 Z축 이동거리:" VerticalAlignment="Center" Width="130"/>
                                    <TextBox x:Name="txtArrayPrintDist" Width="80" Text="0.05" PreviewTextInput="TextBox_PreviewTextInput"/>
                                    <TextBlock Text="프린트 이동 속도:" VerticalAlignment="Center" Width="120" Margin="20,0,0,0"/>
                                    <TextBox x:Name="txtArrayPrintVel" Width="80" Text="0.1" PreviewTextInput="TextBox_PreviewTextInput"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="하강(접촉) 이동 속도:" VerticalAlignment="Center" Width="130"/>
                                    <TextBox x:Name="txtArrayDownVel" Width="80" Text="0.005" PreviewTextInput="TextBox_PreviewTextInput"/>
                                    <TextBlock Text="간격 이동 속도:" VerticalAlignment="Center" Width="120" Margin="20,0,0,0"/>
                                    <TextBox x:Name="txtArrayGapVel" Width="60" Text="0.01" PreviewTextInput="TextBox_PreviewTextInput"/>
                                    <TextBlock Text="mm/s" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="Gray"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="기둥 간격 거리:" VerticalAlignment="Center" Width="130"/>
                                    <TextBox x:Name="txtArrayGapDist" Width="80" Text="0.5" PreviewTextInput="TextBox_PreviewTextInput"/>
                                    <TextBlock Text="루프 횟수:" VerticalAlignment="Center" Width="120" Margin="20,0,0,0"/>
                                    <TextBox x:Name="txtArrayLoops" Width="80" Text="5" PreviewTextInput="TextBox_PreviewTextInput"/>
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="3. 어레이 조건 프리셋 저장" Margin="0,0,0,15" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="저장된 프리셋:" VerticalAlignment="Center" Width="90"/>
                                <ComboBox x:Name="cmbArrayPresets" Width="150" SelectionChanged="cmbArrayPresets_SelectionChanged"/>
                                <TextBlock Text="저장할 이름:" VerticalAlignment="Center" Margin="20,0,7,0"/>
                                <TextBox x:Name="txtPresetName" Width="120" VerticalAlignment="Center"/>
                                <Button Content="현재 조건 저장" Width="100" Margin="10,0,0,0" Click="btnSavePreset_Click"/>
                                <Button Content="선택 삭제" Width="70" Margin="5,0,0,0" Click="btnDeletePreset_Click"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Button x:Name="btnStartArray" Content="어레이 시작 (상대좌표 보정)" Width="180" Height="40" Background="#FFD4EDD4" FontWeight="Bold" Click="btnStartArray_Click"/>
                        <Button x:Name="btnExportArray" Content="매크로용 CSV로 추출" Width="150" Height="40" Margin="15,0,0,0" Click="btnExportArray_Click"/>
                        <Button x:Name="btnStopArray" Content="비상 정지" Width="100" Height="40" Margin="15,0,0,0" Background="#FFFFCCCC" FontWeight="Bold" IsEnabled="False" Click="btnStopArray_Click"/>
                    </StackPanel>
                    <TextBlock x:Name="txtArrayStatus" Grid.Row="2" Text="※ 원하는 시작 위치에 피펫을 컨택한 상태에서 시작하세요. (상대좌표 기준으로 구동됩니다)" Foreground="Blue" HorizontalAlignment="Center" Margin="0,15,0,0"/>
                </Grid>
            </TabItem>
            <TabItem Header="원격 연결">
                <Grid Margin="20">
                    <TextBlock Text="원격 연결 및 통신 기능 준비 중..." FontSize="18" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="도움말">
                <Grid Margin="20">
                    <TextBlock Text="NanoMax 300 제어판 도움말 준비 중..." FontSize="18" Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </TabItem>
            <TabItem Header="설정">
                <Grid Margin="20">
                    <StackPanel>
                        <TextBlock Text="표시 단위 설정" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <TextBlock Text="단위 선택 (여기서 변경 시 모든 탭의 단위가 일괄 변경됩니다):" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="cmbUnits" Width="100" SelectionChanged="cmbUnits_SelectionChanged">
                                <ComboBoxItem Content="mm (밀리미터)" IsSelected="True"/>
                                <ComboBoxItem Content="um (마이크로미터)"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="키보드 미세 제어 (Nudge)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <CheckBox x:Name="chkEnableNudge" Content="키보드 미세 제어 기능 켜기 (←→: X축, ↑↓: Y축, PageUp/Down: Z축)" Margin="0,0,0,10"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,30">
                            <TextBlock Text="이동 거리:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="inNudgeDist" Width="70" Text="0.001" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                            <TextBlock x:Name="unitNudgeDist" Text="mm" VerticalAlignment="Center" Margin="2,0,15,0" Foreground="Gray"/>
                            <TextBlock Text="이동 속도:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="inNudgeVel" Width="70" Text="0.05" VerticalAlignment="Center" PreviewTextInput="TextBox_PreviewTextInput"/>
                            <TextBlock x:Name="unitNudgeVel" Text="mm/s" VerticalAlignment="Center" Margin="2,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                        <TextBlock Text="종료 알림 설정 (웹훅)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <CheckBox x:Name="chkNotifyEveryLoop" Content="매 루프(기둥/반복)마다 완료 알림 받기 (체크 해제 시 전체 종료 후 1회만 알림)" IsChecked="False" Margin="0,0,0,10"/>
                        <StackPanel Margin="0,0,0,30">
                            <TextBlock Text="Discord/Slack 웹훅 URL (비워두면 PC 소리 알림만 울립니다):" Margin="0,0,0,5"/>
                            <TextBox x:Name="txtWebhookUrl" Width="400" HorizontalAlignment="Left" Padding="2" Text="https://discord.com/api/webhooks/1476202774923579455/5afdrtIm3wFpkea0_zRYy93XDFQkM-rZirUXM0nxZsKyEXHPIKqiOHuWBxEBJBtmBo1q"/>
                        </StackPanel>
                        <TextBlock Text="이동 로그 (Log) 관리" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBlock x:Name="txtLogCount" Text="현재 기록된 로그 수: 0개" Margin="0,0,0,10"/>
                        <Button Content="이동 로그 CSV로 추출하기" Width="180" Height="30" HorizontalAlignment="Left" Click="btnExportLog_Click" Margin="0,0,0,30"/>
                        <Separator Margin="0,0,0,20"/>
                        <TextBlock Text="고급 설정 (Advanced)" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <CheckBox x:Name="chkAdminMode" Content="관리자 모드 켜기 (원점 복귀(Home) 버튼 등 고급 제어 활성화)" Margin="0,0,0,10" Checked="chkAdminMode_Checked" Unchecked="chkAdminMode_Unchecked"/>
                        <CheckBox x:Name="chkSimulationMode" Content="가상 시뮬레이터 사용" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="건의함">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="프로그램 사용 중 불편한 점이나 추가되었으면 하는 기능을 적어주세요." FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="작성자 이름:" VerticalAlignment="Center" Width="80"/>
                            <TextBox x:Name="txtName" Width="150" VerticalAlignment="Center"/>
                            <TextBlock Text="※ 날짜와 시간은 제출 시 자동으로 기록됩니다." VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBox x:Name="txtFeedback" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,15" Padding="5"/>
                    <Button Grid.Row="2" Content="의견 보내기 (저장)" Width="150" Height="35" HorizontalAlignment="Right" Background="#FFE6F2FF" Click="btnSubmitFeedback_Click"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>