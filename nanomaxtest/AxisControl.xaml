<UserControl x:Class="nanomaxtest.AxisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" d:DesignHeight="600" d:DesignWidth="350">
    <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10">
        <StackPanel>
            <TextBlock x:Name="txtTitle" x:FieldModifier="public" Text="축 제어" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,15"/>
            <TextBlock x:Name="txtPos" x:FieldModifier="public" Text="현재 위치: 0" FontSize="15" HorizontalAlignment="Center"/>
            <TextBlock x:Name="txtStatus" x:FieldModifier="public" Text="상태: 멈춤" Foreground="Red" HorizontalAlignment="Center" Margin="0,5,0,10"/>

            <Button x:Name="btnHome" x:FieldModifier="public" Content="원점 복귀 (Home)" Height="25" Margin="0,0,0,15" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <TextBlock Text="이동 모드: " VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="cmbMode" x:FieldModifier="public" Width="90" SelectedIndex="0" SelectionChanged="cmbMode_SelectionChanged">
                    <ComboBoxItem Content="상대 좌표"/>
                    <ComboBoxItem Content="절대 좌표"/>
                </ComboBox>
            </StackPanel>

            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="lblTarget" x:FieldModifier="public" Grid.Row="0" Grid.Column="0" Text="이동 거리:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="inTarget" x:FieldModifier="public" Width="70" Text="1" Margin="5"/>
                    <TextBlock x:Name="unitTarget" x:FieldModifier="public" Text="mm" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="이동 속도:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="inVel" x:FieldModifier="public" Width="70" Text="0.5" Margin="5"/>
                    <TextBlock x:Name="unitVel" x:FieldModifier="public" Text="mm/s" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="가속도:" VerticalAlignment="Center"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                    <TextBox x:Name="inAcc" x:FieldModifier="public" Width="70" Text="0.5" Margin="5"/>
                    <TextBlock x:Name="unitAcc" x:FieldModifier="public" Text="mm/s²" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                <Button x:Name="btnMinus" x:FieldModifier="public" Content="- 이동" Width="55" Height="30" Margin="0,0,5,0"/>
                <Button x:Name="btnPlus" x:FieldModifier="public" Content="+ 이동" Width="55" Height="30" Margin="0,0,5,0"/>
                <Button x:Name="btnGo" x:FieldModifier="public" Content="해당 좌표로 이동" Width="115" Height="30" Margin="0,0,5,0" Visibility="Collapsed"/>
                <Button x:Name="btnStop" x:FieldModifier="public" Content="정지" Width="50" Height="30" Background="#FFFFCCCC"/>
            </StackPanel>

            <TextBlock x:Name="txtTime" x:FieldModifier="public" Text="남은 시간: 0초" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="조그 슬라이더" HorizontalAlignment="Center" FontSize="12" Foreground="Gray"/>
            <Slider x:Name="sliderJog" x:FieldModifier="public" Minimum="-100" Maximum="100" Value="0" TickFrequency="10" IsSnapToTickEnabled="True" Margin="10,5,10,0"/>
        </StackPanel>
    </Border>
</UserControl>